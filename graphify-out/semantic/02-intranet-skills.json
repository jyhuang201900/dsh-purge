{
  "nodes": [
    { "id": "skills_redteam_kimi_webbridge", "label": "kimi-webbridge（Kimi 浏览器扩展 + 本地守护进程）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\kimi-webbridge.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "唯一能复用用户真实登录态的浏览器通道；systemd 托管后不能再手动 start/upgrade，否则起游离进程、service 反变 inactive。" },
    { "id": "skills_redteam_kimi_webbridge_extension_policy", "label": "企业策略强装扩展（Chrome 137+ 忽略 --load-extension）", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\kimi-webbridge.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_lateral_movement", "label": "lateral-movement（Impacket 横向与提权）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\lateral-movement.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "横向是手段不是目的，得分点是 server-host 与 central-system；psexec 落地服务噪声大，优先 wmiexec/atexec。" },
    { "id": "skills_redteam_lateral_movement_credential_reuse", "label": "凭据复用 / 本地管理员口令复用（横向命中率最高）", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\lateral-movement.md", "source_location": "L101", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_netexec_scan", "label": "netexec-scan（凭据验证与协议横扫）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\netexec-scan.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "把「一组凭据 × 一批主机 × 多协议」压成一条命令；crackmapexec 已停更，netexec 是直接后继。" },
    { "id": "skills_redteam_netexec_scan_three_step_order", "label": "gogo 铺面 → fscan 打点 → netexec 横扫验证", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\netexec-scan.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_nuclei_scan", "label": "nuclei-scan（13,742 模板的 Nday/1day 检测）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\nuclei-scan.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".nuclei-ignore 默认排除 dos/local/fuzz/bruteforce，去掉这些忽略会打死生产系统；演练只关心 critical/high。" },
    { "id": "skills_redteam_nuclei_scan_poc_first_rule", "label": "先查库再开火（redteam_poc_search 两层：知识库 + 模板库）", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\nuclei-scan.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_oob_verification", "label": "oob-verification（带外验证：盲打的判定之眼）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\oob-verification.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "没有回显不等于没打通；DNS 命中而 HTTP 未命中说明目标能解析但出网被掐，这一差别直接决定下一步打法。" },
    { "id": "skills_redteam_oob_verification_dns_vs_http", "label": "DNS 命中 ≠ HTTP 命中（出网受限判据）", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\oob-verification.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_passive_recon", "label": "passive-recon（不接触目标的被动信息收集）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\passive-recon.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "铁律是一个包都不发给目标；搜索结果里出现内网地址是边界突破线索，不是噪声。" },
    { "id": "skills_redteam_privesc_persistence", "label": "privesc-persistence（提权 + 维持 + 收割三问）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\privesc-persistence.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "一次性 ?cmd= 不是战果，站得住的 shell 才是；维持做完必须断开并用维持入口重连一次，连不上等于没做。" },
    { "id": "skills_redteam_privesc_persistence_three_questions", "label": "三问纪律：能不能提权 / 能不能维持 / 能不能收割", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\privesc-persistence.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_recon_pipeline", "label": "recon-pipeline（subfinder→dnsx→naabu→httpx→katana）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\recon-pipeline.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/usr/bin/httpx 是 Python httpx 库的 CLI 而非 ProjectDiscovery 的，必须 pd-httpx 或绝对路径；katana 未安装。" },
    { "id": "skills_redteam_recon_pipeline_pd_httpx_trap", "label": "pd-httpx 与 Python httpx 同名陷阱", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\recon-pipeline.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_redteam_setup", "label": "redteam-setup（首次引导与降级口径）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\redteam-setup.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm 发布期审查会把「安装后自动下载渗透二进制」判成恶意行为特征，所以插件不替用户下载工具；改 .env 后必须重启 dsh web。" },
    { "id": "skills_redteam_redteam_setup_no_auto_install", "label": "红线：插件不替用户下载/安装安全工具", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\redteam-setup.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_secdev_boundary", "label": "secdev-boundary（安全设备与集权系统，最贵的那发子弹）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\secdev-boundary.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "boundary-physical 30000 / central-system 管理员 500 都远高于业务系统；VPN 登进去必须实测内网可达才算边界突破。" },
    { "id": "skills_redteam_secdev_boundary_bastion_map", "label": "堡垒机 = 内网地图（托管凭据是最高质量输入）", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\secdev-boundary.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null }
