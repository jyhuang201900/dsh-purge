{
  "nodes": [
    { "id": "skills_redteam_active_scan", "label": "active-scan（主动端口与服务扫描）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\active-scan.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nmap -sS / naabu SYN 需要 root，缺权限必须退到 -scan-type c / -sT，否则全端口扫出假空结果。" },
    { "id": "skills_redteam_active_scan_syn_permission", "label": "SYN 扫描权限降级口径", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\active-scan.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_asset_correlation", "label": "asset-correlation（资产关联与易打性排序）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\asset-correlation.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "产出必须是「先打谁」的排序而不是又扫一遍；边缘/测试环境与非标端口补丁落后，优先级高于主站生产。" },
    { "id": "skills_redteam_asset_correlation_edge_types", "label": "五种资产关系边（resolves/contains/exposes/shares_cert/trusts）", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\asset-correlation.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_browser_automation", "label": "browser-automation（headless Chrome 抓取）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\browser-automation.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "chromium 命令行零依赖最快；playwright-cli 默认 chrome 通道会报 not found，必须 --browser chromium。" },
    { "id": "skills_redteam_chisel_tunnel", "label": "chisel-tunnel（HTTP/WebSocket 隧道）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\chisel-tunnel.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "只放行 80/443 的出网策略下 chisel 最好穿；前提是只要「有命令执行」，不像 suo5 必须有 WebShell。" },
    { "id": "skills_redteam_chisel_tunnel_entry_kind", "label": "entry_kind=target-outbound（不算突破的判据）", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\chisel-tunnel.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_cn_proxy_pool", "label": "cn-proxy-pool（国内免费代理池）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\cn-proxy-pool.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "免费代理定位是降低被封风险而非隐藏身份；铁规则是只允许命令级代理参数，绝不动本机网络与代理配置。" },
    { "id": "skills_redteam_cn_proxy_pool_command_scope_rule", "label": "命令级代理铁规则（禁改全局配置）", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\cn-proxy-pool.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_credential_attack", "label": "credential-attack（hydra 在线爆破 + hashcat 离线破解）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\credential-attack.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "只有凭据不算拿到账号，必须真实浏览器登录一次；同一账号连续失败 5 次就停，把账号打锁等于毁掉入口。" },
    { "id": "skills_redteam_credential_attack_web_form_verdict", "label": "http-post-form 的 F=/S= 成败判定", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\credential-attack.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_dir_bruteforce", "label": "dir-bruteforce（目录与文件爆破）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\dir-bruteforce.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "实战里大部分入口不是 CVE 打进去的而是爆破扫出来的；四工具字典与判定逻辑不同，必须互补而非只用一个。" },
    { "id": "skills_redteam_fofa_recon", "label": "fofa-recon（FOFA 资产测绘，限速安全版）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\fofa-recon.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "官方并发限额按秒计（个人/专业版 1 秒 1 次），实测超限返回 HTTP 429 + [45012] 请求速度过快，所以严格单线程 + 最小间隔 + 退避。" },
    { "id": "skills_redteam_fofa_recon_45012_backoff", "label": "45012 限速退避与硬预算", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\fofa-recon.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_frp_tunnel", "label": "frp-tunnel（frps/frpc 内网穿透）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\frp-tunnel.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "frp 专为长期稳定设计（自动重连、TLS、多路复用），要长期挂着并把端口直接交给用户时用 frp 而非 chisel。" },
    { "id": "skills_redteam_fscan_intranet", "label": "fscan-intranet（内网综合扫描 v2.2.1）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\fscan-intranet.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "默认 600 线程对老设备与工控很危险，先 -nobr -nopoc 拿资产面再放开爆破；内网扫描必须在能到达内网的位置执行。" },
    { "id": "skills_redteam_gogo_intranet", "label": "gogo-intranet（内网测绘与指纹引擎 v2.15.0）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\gogo-intranet.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "最小发包原则 + 内置 3138 条指纹，单静态二进制零依赖，Windows 2003 都能跑；大网段先 gogo 铺面再 fscan 打点。" },
    { "id": "skills_redteam_gogo_intranet_port_presets", "label": "gogo 端口预设 tag（top1/top2/win/db/all）", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\gogo-intranet.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_injection_payloads", "label": "injection-payloads（SQLi/命令注入/SSTI/反序列化载荷库）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\injection-payloads.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "布尔差分看响应长度差而不是「看起来不一样」；时间盲注必须跑 3 次取中位数，单次 5s 不算证据；sqlmap 不一定装，先探再点名。" },
    { "id": "skills_redteam_injection_payloads_oob_dns", "label": "无回显 → DNS 外带（63 字符标签上限）", "file_type": "concept", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\injection-payloads.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null },
    { "id": "skills_redteam_iot_iiot_netdev", "label": "iot-iiot-netdev（物联网/工控/网络设备得分面）", "file_type": "document", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\iot-iiot-netdev.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "这三条得分点竞争少、默认配置存活率高；工控写线圈会真的动阀门，扫描过狠老 PLC 会宕机。" },
    { "id": "skills_redteam_iot_iiot_netdev_snmp_map", "label": "SNMP 路由表/接口表 = 内网免费地图", "file_type": "rationale", "source_file": "E:\\完成项目\\dsh-purge\\skills\\redteam\\iot-iiot-netdev.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null }
  ],
