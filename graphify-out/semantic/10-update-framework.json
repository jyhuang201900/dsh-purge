  "nodes": [
    { "id": "docs_update_framework_channel_lane", "label": "渠道双车道与钉选（stable=master / beta，pin 固定旧版本）", "file_type": "concept", "source_file": "lib/update.js", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "插件只允许用户在面板手动更新，启动路径永不自动升（autoUpdateIfNeeded 返回 skipped=manual-only）——版本适配依赖本机宿主，自动升级会把补丁锚点打到没验证过的宿主上。" },
    { "id": "docs_update_framework_marker", "label": "官方客户端升级回写标记 dsh-purge-reapply-asar", "file_type": "concept", "source_file": "lib/official-update.js", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "闭环三段：重启 wscript 在 resources 下写 marker → 下次启动 lib/index.js 读 marker → 清 marker 并清掉残留的 app.dshpurge-prev* 目录。宿主 EXE 自更新会换掉 asar，没有这个标记就没人知道补丁已经随旧 asar 一起没了。" },
    { "id": "docs_update_framework_reapply_heal", "label": "宿主重置后的补丁判失与 applied stamp 自愈", "file_type": "concept", "source_file": "lib/reapply.js", "source_location": "L212", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "空 sha 或缺失 installed-rev 会让 settle 每次启动都 reapply+restart（无限重启）；#59/#61 还要求自愈重启不反复弹浏览器窗口。" },
    { "id": "lib_update_update_ledger", "label": "updateLedger()：渠道/升级史/守卫的对外读点", "file_type": "concept", "source_file": "lib/update.js", "source_location": "L188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "version-history.json 原本只被 pushHistory 自己读去做同 ref 去重，auto-update-guard.json 更是只写不读——按「记了但没人读 = 没有这个功能」，这两个台账此前不构成功能；现在 checkUpdate / autoUpdateIfNeeded / CLI --status 三处都读它。" }
  ],
