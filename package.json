{
  "name": "dsh-purge",
  "version": "1.1.85",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. Built-in red-team attack doctrine and 114 drill skills (32 offense-flow + 16 reverse/specialty).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "locale",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "check-anchors": "node scripts/check-anchors.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "sweep:market": "node scripts/market-sweep.mjs",
    "check-size": "node scripts/check-size.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "build:locale": "node scripts/build-locale.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:tools": "node scripts/check-tools.mjs",
    "scenario": "node scripts/scenario-drill.mjs",
    "probe:gates": "node scripts/probe-gates.mjs",
    "audit:skills": "node scripts/audit-skills.mjs",
    "sync:bundled": "node scripts/sync-bundled.mjs",
    "runnable:inject": "node scripts/inject-runnability.mjs",
    "runnable:check": "node scripts/check-skill-runnable.mjs",
    "build:skills-graph": "node scripts/build-skill-graph.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "quality:second-shot": "node scripts/check-second-shot.mjs",
    "scope:check": "node scripts/check-scope-gate.mjs",
    "sync:skills": "node scripts/sync-bundled.mjs",
    "toolkit:windows": "node scripts/toolkit-windows.mjs",
    "toolkit:check": "node scripts/toolkit-windows.mjs --check",
    "test:hygiene": "node scripts/hygiene-selftest.mjs",
    "smoke:cli": "node scripts/cli-smoke.mjs",
    "smoke:write": "node scripts/write-smoke.mjs",
    "smoke:tools": "node scripts/tools-smoke.mjs",
    "audit:graph": "node scripts/graph-audit.mjs",
    "report": "node scripts/report.mjs",
    "verify": "node scripts/verify.mjs",
    "build:client": "node scripts/build-client.mjs",
    "graphify": "node scripts/graphify-sync.mjs --cluster",
    "host-sync": "node scripts/host-sync.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent",
    "mcp",
    "cordis",
    "skill",
    "skills",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyhuang201900/dsh-purge.git"
  },
  "homepage": "https://github.com/jyhuang201900/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/jyhuang201900/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/jyhuang201900/dsh-purge/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/jyhuang201900/dsh-purge/archive/refs/heads/master.zip",
      "git": "https://github.com/jyhuang201900/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2 <0.2.3-0"
  },
  "dshTarget": "0.2.2-rc.1"
}
